# development = dados de demonstração e cookie sem Secure.
# production  = sem dados demo, cookie Secure, troca de senha obrigatória no 1º login do admin.
APP_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://movimento:movimento@localhost:5433/movimento
# Conexão direta para migrations. Com pooler (Neon), DATABASE_URL usa o pooler e esta não
DIRECT_URL=postgresql://movimento:movimento@localhost:5433/movimento

# Gere o seu em produção: openssl rand -base64 48
JWT_SECRET=dev-only-troque-este-segredo-em-producao-0123456789

# Copie para .env e defina as suas. Nenhuma senha real ou de demonstração fica neste arquivo.
# Administrador criado pelo seed
ADMIN_EMAIL=admin@exemplo.test
ADMIN_PASSWORD=defina-uma-senha-forte

# Senha de todos os usuários de demonstração (recepção, fisioterapeutas, pacientes)
DEMO_PASSWORD=defina-uma-senha-de-demonstracao

# SMTP (Mailpit em desenvolvimento: UI em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Clínica Movimento <nao-responda@exemplo.test>"

# Pasta dos vídeos/arquivos enviados pelas fisioterapeutas
UPLOAD_DIR=./uploads

# Banner e botão de reset. false em produção real
NEXT_PUBLIC_DEMO_MODE=true

# Protege GET /api/cron/tick (agendador na Vercel)
CRON_SECRET=

# Intervalo do agendador interno (lembretes e fila de notificações), em ms
CRON_INTERVAL_MS=60000

# PIX estático (BR Code). Valores fictícios: use a chave real só no .env, que não vai para o git
PIX_PROVIDER=static
PIX_KEY=pix-demonstracao@exemplo.test
PIX_MERCHANT_NAME=Clinica Movimento Demo
PIX_MERCHANT_CITY=Recife

# PSP para confirmação automática (PIX_PROVIDER=psp). Desativado: veja o README
PSP_BASE_URL=
PSP_TOKEN=
PSP_WEBHOOK_SECRET=

# WhatsApp: false = simulação na Caixa do WhatsApp da recepção; true = Cloud API da Meta
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
